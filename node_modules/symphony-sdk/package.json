{
  "name": "symphony-sdk",
  "version": "2.4.8",
  "description": "SDK for interacting with Symphony Aggregator",
  "type": "module",
  "main": "dist/bundle.js",
  "module": "dist/bundle.js",
  "exports": {
    "./viem": {
      "import": "./dist/viem/index.js",
      "require": "./dist/viem/index.js"
    },
    "./ethers": {
      "import": "./dist/ethers/index.js",
      "require": "./dist/ethers/index.js"
    },
    "./ethersv5": {
      "import": "./dist/ethersv5/index.js",
      "require": "./dist/ethersv5/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "author": "0xhwk",
  "license": "MIT",
  "directories": {
    "viem": "./viem",
    "ethers": "./ethers",
    "entities": "./entities",
    "common": "./common"
  },
  "peerDependencies": {
    "ethers": "^5.7.2 || ^6.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^29.7.0",
    "dotenv": "^16.4.7",
    "ethers-v5": "npm:ethers@^5.7.2",
    "ethers-v6": "npm:ethers@^6.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "rollup": "^3.20.0",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "viem": "^2.21.54"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "symphony",
    "aggregator",
    "sdk",
    "ethereum",
    "viem",
    "ethers"
  ],
  "engines": {
    "node": ">=14"
  }
}
